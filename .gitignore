# Complete local mirror of the Modal results volume, written by `make pull-results`.
# Every run's outputs and logs; model weights are on a separate volume and never pulled.
# Deliberately untracked: this is the raw record of what was run, and the curated subset
# lives in results/. Kept on disk so any number can be traced back to its own run log.
/modal_outputs/
/modal_outputs.partial/
# Former name of the same thing, still ignored so an old local copy cannot be committed.
/results_modal/
/results_modal.partial/

# Superseded results. Kept on disk as provenance, deliberately NOT shared: each
# contradicts a number the paper now reports. See results/README.md.
/results/report_plots
/results/report_plots_rerun/09_compiler_analysis.png
/results/compiler/profiler_trace
/results/compiler/nvtx_trace.json
/results/compiler/metrics_summary.json
/results/compiler/graph11_graph_breaks.png
/results/compiler/graph12_compile_modes.png
/results/compiler/graph13_roofline.png
/results/compiler/graph14_dense_comparison.png
/results/kernels_a100
/results/kernels/olmoe/profile_amdahl.csv
